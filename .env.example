# Public hostname for tproxy-server (A/AAAA DNS record must point to your server IP)
TPROXY_HOSTNAME=proxy.example.com

# Email address for automatic TLS certificates via Let's Encrypt / ZeroSSL
ACME_EMAIL=admin@example.com

# 16-byte hex secret for MTProxy (32 lowercase hex characters)
# Generate with: openssl rand -hex 16
TPROXY_SECRET=000102030405060708090a0b0c0d0e0f
